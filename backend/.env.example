# .env.example (ALYGEN CRM)

# ─── Runtime ───
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173,http://127.0.0.1:4000

# Proteção opcional da API (Express + FastAPI). Se vazio, auth desativada em dev.
ALYGEN_API_KEY=
UNSUBSCRIBE_HMAC_SECRET=

# ─── IA (Groq = LLM principal; nomes OPENAI_* são compatibilidade Groq) ───
# Uma chave OU várias separadas por vírgula (rotação Node + Python em rate limit)
GROQ_API_KEY=
# GROQ_API_KEYS=gsk_xxx,gsk_yyy,gsk_zzz
# Opcional: tracing Langfuse (Python gateway + agentes)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# Opcional: OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
PAGESPEED_API_KEY=

# ─── Python FastAPI (market-intel, scoring) ───
PYTHON_FASTAPI_URL=http://localhost:3003
PYTHON_SERVICE_URL=http://localhost:3003
PYTHON_PORT=3003

# ─── Postgres local (fonte única de verdade) ───
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=alygen_crm
JWT_SECRET=
ADMIN_EMAIL=admin@alygen.pt
ADMIN_PASSWORD=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_DISABLE=true  # força só Groq no gateway Python
PUBLIC_API_URL=http://localhost:3001
AUDIT_CACHE_TTL_DAYS=30

# ─── Integrações ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CALENDLY_WEBHOOK_SECRET=

# ─── Performance / limites ───
FETCH_LEADS_ANALYSIS_LIMIT=5000
RATE_LIMIT_GLOBAL_MAX=10000
RATE_LIMIT_ANALYSIS_MAX=200
