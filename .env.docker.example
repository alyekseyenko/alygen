# Copiar para .env na raiz do projeto (Docker Compose lê isto automaticamente)
# cp .env.docker.example .env   — ou no PowerShell: Copy-Item .env.docker.example .env

PGUSER=postgres
PGPASSWORD=altere-esta-password-postgres
PGDATABASE=alygen_crm

# Mín. ~32 caracteres
JWT_SECRET=altere-este-segredo-jwt-com-32-chars-min

# Mesma chave no frontend (build) e no backend
ALYGEN_API_KEY=alygen-chave-local-pc

PUBLIC_ORIGIN=http://localhost:8080
HTTP_PORT=8080

# Dev compose (docker-compose.yml): se 3001/4000 já estiverem ocupados no PC
# BACKEND_HOST_PORT=3002
# FRONTEND_HOST_PORT=4001
# PYTHON_HOST_PORT=3003
# Ollama no host (Docker Desktop Windows)
OLLAMA_URL=http://host.docker.internal:11434
