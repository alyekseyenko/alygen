# Alygen CRM — Configurações de Ambiente (.env)

# --- SUPABASE DATABASE ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-ai-rls-bypass

# --- GOOGLE SHEETS INTEGRATION ---
GOOGLE_SHEETS_ID=your-google-sheets-spreadsheet-id

# --- AI & ANALYTICS APIs ---
GROQ_API_KEY=gsk_your-groq-api-key-here
PAGESPEED_API_KEY=your-google-pagespeed-api-key-here

# --- SMTP OUTREACH CREDENTIALS ---
SMTP_HOST=smtp.mail.com
SMTP_PORT=587
SMTP_USER=outreach@yourdomain.com
SMTP_PASS=your-smtp-password

# --- TELEGRAM BOT GOVERNANCE ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=your-telegram-chat-id-for-approvals

# --- PYTHON MICROSERVICES PORT ---
PYTHON_PORT=3003
PYTHON_HOST=0.0.0.0
