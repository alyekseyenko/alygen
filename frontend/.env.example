# Copiar para .env.local (Vite carrega .env.local automaticamente)

# URL do backend Node (dev: proxy Vite; prod nginx: deixar vazio = mesmo origin)
# VITE_API_URL=http://localhost:3001

# Exigir login JWT antes de aceder ao CRM
# VITE_REQUIRE_AUTH=true

# Opcional: mesma chave que ALYGEN_API_KEY (registo bootstrap / fallback)
# VITE_API_KEY=
